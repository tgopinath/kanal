{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/models/(.*).usdz", "headers": [{ "key": "Content-Type", "value": "model/vnd.usdz+zip" }, { "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/models/(.*).glb", "headers": [{ "key": "Content-Type", "value": "model/gltf-binary" }, { "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
